{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-name",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "KEY": "VALUE"
  },
  "kv_namespaces": [
    {
      "binding": "MY_KV",
      "id": "ID_HERE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
